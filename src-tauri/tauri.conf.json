{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustCleaner",
  "version": "0.1.0",
  "identifier": "local.rustcleaner.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "rustCleaner", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 580 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
